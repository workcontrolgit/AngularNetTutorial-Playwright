
# Credentials — never commit real values (commit only *.example files)
.env
.env.dev
.env.prod

# Playwright auth state — contains JWT tokens, regenerated by auth.setup.ts
/.auth/

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
